<?xml version="1.0" encoding="utf-8"?>
<!--
  基准档：smallest width < 600dp 的电视（约 960×540dp，
  例如 1080p 电视被系统报成 320dpi 的情况）。
  其它档位见 values-sw600dp / values-sw900dp。
-->
<resources>
    <!-- 页面留白 -->
    <dimen name="pad_screen_h">48dp</dimen>
    <dimen name="pad_screen_v">20dp</dimen>

    <!-- 标题区 -->
    <dimen name="icon_head">53dp</dimen>
    <dimen name="gap_icon_text">17dp</dimen>
    <dimen name="gap_sub_top">5dp</dimen>
    <dimen name="text_title">24sp</dimen>
    <dimen name="text_sub">11sp</dimen>

    <!-- 统计卡片 -->
    <dimen name="gap_header_stats">17dp</dimen>
    <dimen name="card_pad_h">21dp</dimen>
    <dimen name="card_pad_v">14dp</dimen>
    <dimen name="radius_card">12dp</dimen>
    <dimen name="gap_card">15dp</dimen>
    <dimen name="text_card_cap">11sp</dimen>
    <dimen name="text_card_val">23sp</dimen>

    <!-- 状态行 -->
    <dimen name="gap_status_top">12dp</dimen>
    <dimen name="gap_status_bottom">8dp</dimen>
    <dimen name="text_status">12sp</dimen>

    <!-- 按钮 -->
    <dimen name="gap_btn">5dp</dimen>
    <dimen name="btn_height">48dp</dimen>
    <dimen name="btn_pad_h">26dp</dimen>
